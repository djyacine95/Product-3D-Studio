# Copy this file to ".env.local" and fill in the values.
# NEVER commit .env.local to GitHub: it contains secrets.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (PostgreSQL, e.g. from Neon) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Login with Google (Auth.js) ----
# Create AUTH_SECRET with:  npx auth secret
AUTH_SECRET=
# Only needed when you run "npm start" on your own computer (Vercel sets it for you)
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Payments (Stripe, test mode keys start with sk_test_) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ---- File storage (Vercel Blob) - optional on your computer ----
BLOB_READ_WRITE_TOKEN=

# ---- AI 3D reconstruction (Meshy) - optional ----
MESHY_API_KEY=
